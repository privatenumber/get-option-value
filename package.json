{
	"name": "get-option-value",
	"version": "0.0.0-semantic-release",
	"description": "Type-safe, tree-shakable reader of Node.js CLI option values",
	"keywords": [
		"node",
		"options",
		"cli",
		"flags",
		"getOptionValue",
		"argv",
		"NODE_OPTIONS",
		"execArgv"
	],
	"license": "MIT",
	"repository": "privatenumber/get-option-value",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./flags": {
			"types": "./dist/flags.d.mts",
			"default": "./dist/flags.mjs"
		}
	},
	"imports": {
		"#get-option-value": {
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"#get-option-value/flags": {
			"development": "./src/flags.ts",
			"default": "./dist/flags.mjs"
		}
	},
	"packageManager": "pnpm@10.20.0",
	"scripts": {
		"bench": "node --expose-gc benchmark/library.ts",
		"build": "pkgroll --clean-dist",
		"generate": "node scripts/generate-flags/index.ts && mdeval README.md",
		"lint": "lintroll --cache --git --ignore-pattern src/flags.ts --ignore-pattern 'tests/fixtures/**'",
		"test": "pnpm build && node tests/index.ts",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json",
		"prepare": "skills-npm"
	},
	"engines": {
		"node": ">=18"
	},
	"devDependencies": {
		"@types/node": "^26.1.0",
		"clean-pkg-json": "^2.0.0",
		"esbuild": "^0.28.1",
		"get-node": "^15.0.4",
		"lintroll": "^1.30.2",
		"manten": "^2.0.1",
		"md-pen": "^1.2.0",
		"mdeval": "^1.6.0",
		"mitata": "^1.0.34",
		"nano-spawn": "^2.1.0",
		"pkgroll": "^2.27.1",
		"skills-npm": "^1.2.0",
		"typescript": "^6.0.3"
	}
}
